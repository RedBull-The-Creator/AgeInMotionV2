<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="12dp"
    android:paddingRight="12dp"
    android:paddingTop="7dp"
    android:paddingBottom="6dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="0.000000000"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="sans"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:includeFontPadding="false" />

    <TextView
        android:id="@+id/unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="YEARS"
        android:textColor="#9A9A9A"
        android:textSize="7sp"
        android:letterSpacing="0.22"
        android:includeFontPadding="false"
        android:paddingTop="2dp" />

    <LinearLayout
        android:id="@+id/progress_area"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:paddingTop="4dp">

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:max="10000"
            android:progress="0"
            android:progressDrawable="@drawable/progress_fill"
            android:background="@drawable/progress_track" />

        <TextView
            android:id="@+id/percent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="right"
            android:text="0.00%"
            android:textColor="#9A9A9A"
            android:textSize="7sp"
            android:includeFontPadding="false"
            android:paddingTop="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="TIME IS MOVING"
        android:textColor="#FFFFFF"
        android:textSize="7sp"
        android:letterSpacing="0.12"
        android:includeFontPadding="false"
        android:paddingTop="3dp" />

    <TextView
        android:id="@+id/day_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00 HOURS   00 MINUTES   00 SECONDS"
        android:textColor="#888888"
        android:textSize="6sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/remaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="00:00:00 REMAINING"
        android:textColor="#777777"
        android:textSize="6sp"
        android:visibility="gone" />
</LinearLayout>
